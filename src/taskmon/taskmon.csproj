<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Task.Monitor</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The UI text in Resources\Strings.resx is British English. Strings.<culture>.resx
             files override it, and NativeAOT compiles them into the executable. -->
        <NeutralLanguage>en-GB</NeutralLanguage>
        <!-- IDEs load a project by running only its compile step, so generate the Strings class
             there as well; otherwise Rider can't see it. -->
        <CoreCompileDependsOn>PrepareResources;$(CoreCompileDependsOn)</CoreCompileDependsOn>
    </PropertyGroup>

    <ItemGroup>
      <!-- Generates the Strings class at build time, with no Visual Studio custom tool. -->
      <EmbeddedResource Update="Resources\Strings.resx">
        <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
        <StronglyTypedNamespace>Task.Monitor.Resources</StronglyTypedNamespace>
        <StronglyTypedClassName>Strings</StronglyTypedClassName>
        <StronglyTypedFileName>$(IntermediateOutputPath)Strings.g.cs</StronglyTypedFileName>
      </EmbeddedResource>
      <None Remove="Assets\Themes\Windows XP.theme" />
      <EmbeddedResource Include="Assets\Themes\Windows XP.theme" />
      <None Remove="Assets\Themes\Windows 11 Dark.theme" />
      <EmbeddedResource Include="Assets\Themes\Windows 11 Dark.theme" />
