[Cpu and Memory Large]
; A split tree (see SummaryLayout2). Each node is one of:
;   split,<Row|Column>,<ratio>,<first>,<second>  - Row = side by side, Column = stacked,
;                                                   ratio = the first child's share
;   pane,<control>[,<process columns joined with +>]
; Cpu and Memory side by side over the process list, the charts taking 80% of the height.
layout-type=tree
root=0
nodes=0,1,2,3,4
node.0=split,Column,0.8,1,2
node.1=split,Row,0.5,3,4
node.2=pane,Process
node.3=pane,Cpu
node.4=pane,Memory
