[Gpu and Gpu Memory]
; A split tree (see SummaryControlLayout). Each node is one of:
;   split,<Row|Column>,<ratio>,<first>,<second>  - Row = side by side, Column = stacked,
;                                                   ratio = the first child's share
;   pane,<control>[,<process columns joined with +>]
; Gpu and Gpu Memory side by side over the process list, the charts taking 60% of the height.
layout-type=tree
root=0
nodes=0,1,2,3,4
node.0=split,Column,0.6,1,2
node.1=split,Row,0.5,3,4
node.2=pane,Process
node.3=pane,Gpu
node.4=pane,GpuMemory
