[Disk Read and Write Bytes Large]
; A split tree (see SummaryControlLayout). Each node is one of:
;   split,<Row|Column>,<ratio>,<first>,<second>  - Row = side by side, Column = stacked,
;                                                   ratio = the first child's share
;   pane,<control>[,<process columns joined with +>]
; The Disk chart over the process list, the chart taking 80% of the height.
layout-type=tree
root=0
nodes=0,1,2
node.0=split,Column,0.8,1,2
node.1=pane,Disk
node.2=pane,Process
