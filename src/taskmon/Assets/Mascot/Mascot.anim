;=============================================================================
; Task Monitor (taskmon) - About screen mascot
;=============================================================================
; [palette]          One colour per letter (case-sensitive). '.' is transparent: the
;                    screen background shows through.
; [frame <name>]     Pixel rows, all frames the same size. Two pixel rows draw as one
;                    text row using half blocks, so the height must be even.
; [timeline <name>]  Steps of: frame, milliseconds, column offset from the resting
;                    position. Only the last step may be 0 ms: the frame it rests on.
; [idle]             After the intro: frame, milliseconds, every (ms), random extra (ms).
;=============================================================================

[palette]
o=#1E2430   ; outline
c=#D8D0BA   ; casing
C=#A0967E   ; casing shade
k=#555B66   ; antenna stalk, neck, arms and legs
s=#13212A   ; screen glass
y=#5F7F8C   ; screen glare
g=#48F58A   ; phosphor
G=#1F7A45   ; phosphor, dim
W=#E4FFEE   ; phosphor, bright (CRT warm-up)
r=#FF5C5C   ; antenna, power LED, meter (high)
Y=#FFC83D   ; meter (mid)

