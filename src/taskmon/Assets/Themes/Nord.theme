;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[Nord]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#434c5ecc
control.background.highlight.inactive=#708090
control.foreground=#8FBCBB
control.foreground.highlight.focused=#81a1c199
control.foreground.highlight.inactive=#81a1c199
control.border=#8FBCBB
control.border.focused=#EBCB8B

chart.border=#8FBCBB
chart.yaxis=#A3BE8C
chart.title=#8FBCBB
chart.grid=#A9A9A9
chart.range.low.background=#616E88
chart.range.low.foreground=#222222
chart.range.mid.background=#81A1C1
chart.range.mid.foreground=#222222
chart.range.high.background=#8FBCBB
chart.range.high.foreground=#222222

listview.background=transparent
listview.foreground=#8FBCBB
listview.border=#8FBCBB
listview.header.background=#3b4252
listview.header.foreground=#d8dee9

performance.panel.background=transparent
performance.panel.foreground=#8FBCBB
performance.panel.titlebar.background=#3b4252
performance.panel.titlebar.foreground=#d8dee9
performance.cpu.kernel=#8FBCBB
performance.cpu.user=#A3BE8C
performance.memory.inuse=#8FBCBB
performance.memory.modified=#A3BE8C
performance.memory.standby=#81A1C1
performance.memory.free=#616E88

process.list.normaluserspace=#A3BE8C
process.list.lowpriority=#81A1C1
process.list.highcpu=#8FBCBB
process.list.iobound=#ECEFF4
process.list.script=#8FBCBB
process.list.user.currentnonroot=#616E88
process.list.user.othernonroot=#88C0D0
process.list.user.system=#ECEFF4
process.list.user.root=#ECEFF4
process.list.deltahighlight=#5E81AC

heatmap.size.small=#616E88
heatmap.size.mid=#81A1C1
heatmap.size.large=#8FBCBB
heatmap.state.scanning=#222222
heatmap.state.completed=#222222
heatmap.state.faulted=#222222

app.error=#db61a2

menubar.foreground=#d8dee9
menubar.background=#3b4252

command.foreground=#d8dee9
command.background=#3b4252
