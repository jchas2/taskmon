;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; This is a reference copy of a theme built into taskmon. taskmon doesn't
; load it, and puts it back as shipped each time it starts, so any changes
; made here are lost.
;
; How to create a custom theme:
;   Step 1: Copy this file into the themes folder, one level up, under a new
;           name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]". A
;           custom theme can't use the name of a built-in theme.
;   Step 3: Change the colours (#RRGGBB, or transparent).
;   Step 4: Keep "version=2". A theme file without it, or with another
;           version, is skipped.
;=============================================================================
[Shades of Purple]
version=2
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#B362FF
control.background.highlight.inactive=#708090
control.foreground=#B362FF
control.foreground.highlight.focused=#FFFFFF0D
control.foreground.highlight.inactive=#FFFFFF0D
control.border=#B362FF
control.border.focused=#FFEE80

chart.background=transparent
chart.borderforeground=#B362FF
chart.borderbackground=transparent
chart.yaxis=#A5FF90
chart.title=#B362FF
chart.grid=#A9A9A9
chart.range.low.background=#A5FF90
chart.range.low.foreground=#222222
chart.range.mid.background=#FF9D00
chart.range.mid.foreground=#222222
chart.range.high.background=#B362FF
chart.range.high.foreground=#222222

metre.background=transparent
metre.foreground=#B362FF
metre.borderforeground=#B362FF
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#FF9D00
listview.borderforeground=#B362FF
listview.borderbackground=transparent
listview.header.background=#222244
listview.header.foreground=#FFFFFF

dialog.background=#222244
dialog.foreground=#FFFFFF
dialog.border=#FFFFFF
dialog.button.background=#B362FF
dialog.button.foreground=#FFFFFF0D
dialog.button.focus=#ff0000
dialog.list.background=#16162c
dialog.list.foreground=#FFFFFF

performance.panel.background=transparent
performance.panel.foreground=#B362FF
performance.panel.titlebar.background=#222244
performance.panel.titlebar.foreground=#FFFFFF
performance.cpu.kernel=#B362FF
performance.cpu.user=#A5FF90
performance.memory.inuse=#B362FF
performance.memory.modified=#A5FF90
performance.memory.standby=#FF9D00
performance.memory.free=#A5FF90

property.key=#FF9D00
property.value=#9EFFFF

process.list.normaluserspace=#A5FF90
process.list.lowpriority=#FF628C
process.list.highcpu=#B362FF
process.list.iobound=#E1EFFF
process.list.script=#80FFBB
process.list.user.currentnonroot=#B362FF
process.list.user.othernonroot=#FF9D00
process.list.user.system=#FFEE80
process.list.user.root=#FFEE80
process.list.deltahighlight=#9EFFFF

heatmap.state.scanning=#FF9D00
heatmap.state.completed=#A5FF90
heatmap.state.faulted=#B362FF

app.error=#db61a2

status.ok=#A5FF90
status.warning=#FF9D00
status.error=#B362FF

menubar.foreground=#FFFFFF
menubar.background=#222244

command.foreground=#FFFFFF
command.background=#222244
command.foreground.disabled=#808080

statusbar.banner.background=#B362FF
statusbar.banner.foreground=#FFFFFF0D
statusbar.status.ok=#008000
statusbar.status.warning=#ffa500
statusbar.status.error=#ff4500
statusbar.pulse=#00bfff
statusbar.health.ok.background=#A5FF90
statusbar.health.ok.foreground=#000000
statusbar.health.warning.background=#FF9D00
statusbar.health.warning.foreground=#000000
statusbar.health.critical.background=#B362FF
statusbar.health.critical.foreground=#000000
statusbar.health.unknown.background=#808080
statusbar.health.unknown.foreground=#000000

hotkey.key=#00BFFF
hotkey.name=#B362FF

tip.glyph=#FFA500
