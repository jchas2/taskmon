;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[macOS Classic]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#004a9e
control.background.highlight.inactive=#708090
control.foreground=#E19773
control.foreground.highlight.focused=#ffffff
control.foreground.highlight.inactive=#ffffff
control.border=#E19773
control.border.focused=#ffd60a

chart.background=transparent
chart.borderforeground=#E19773
chart.borderbackground=transparent
chart.yaxis=#ffffff
chart.title=#E19773
chart.grid=#A9A9A9
chart.range.low.background=#76BA53
chart.range.low.foreground=#000000
chart.range.mid.background=#ffd60a
chart.range.mid.foreground=#000000
chart.range.high.background=#AC98AD
chart.range.high.foreground=#000000

metre.background=transparent
metre.foreground=#E19773
metre.borderforeground=#E19773
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#E19773
listview.borderforeground=#E19773
listview.borderbackground=transparent
listview.header.background=#1e1e1e
listview.header.foreground=#858585

performance.panel.background=transparent
performance.panel.foreground=#E19773
performance.panel.titlebar.background=#1e1e1e
performance.panel.titlebar.foreground=#858585
performance.cpu.kernel=#AC98AD
performance.cpu.user=#ffffff
performance.memory.inuse=#AC98AD
performance.memory.modified=#ffffff
performance.memory.standby=#ffd60a
performance.memory.free=#76BA53

property.key=#E19773
property.value=#E19773

process.list.normaluserspace=#ffffff
process.list.lowpriority=#b5cea8
process.list.highcpu=#AC98AD
process.list.iobound=#ffd60a
process.list.script=#b5cea8
process.list.user.currentnonroot=#76BA53
process.list.user.othernonroot=#76BA53
process.list.user.system=#ce9178
process.list.user.root=#ce9178
process.list.deltahighlight=#E1D797

heatmap.size.small=#76BA53
heatmap.size.mid=#ffd60a
heatmap.size.large=#AC98AD
heatmap.state.scanning=#000000
heatmap.state.completed=#000000
heatmap.state.faulted=#000000

app.error=#ff453a

menubar.foreground=#858585
menubar.background=#1e1e1e

command.foreground=#d4d4d4
command.background=#1e1e1e
