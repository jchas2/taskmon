;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[macOS Classic]
colour-mode=indexed

background=transparent
background-highlight=#004a9e

chart-border=#E19773
chart-y-axis=#ffffff

col-cmd-normal-user-space=#ffffff
col-cmd-low-priority=#b5cea8
col-cmd-high-cpu=#AC98AD
col-cmd-io-bound=#ffd60a
col-cmd-script=#b5cea8
col-user-current-non-root=#76BA53
col-user-other-non-root=#76BA53
col-user-system=#ce9178
col-user-root=#ce9178

command-foreground=#d4d4d4
command-background=#1e1e1e

delta-highlight-colour=#E1D797
;delta-highlight-colour=#ffff00

error=#ff453a

foreground=#E19773
foreground-highlight=#ffffff

menubar-foreground=#858585
menubar-background=#1e1e1e

range-high-background=#AC98AD
range-low-background=#76BA53
range-mid-background=#ffd60a
range-high-foreground=#000000
range-low-foreground=#000000
range-mid-foreground=#000000

header-background=#1e1e1e
header-foreground=#858585
