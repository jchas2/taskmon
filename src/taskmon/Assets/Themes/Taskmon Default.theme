;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; This is a reference copy of a theme built into taskmon. taskmon doesn't
; load it, and puts it back as shipped each time it starts, so any changes
; made here are lost.
;
; How to create a custom theme:
;   Step 1: Copy this file into the themes folder, one level up, under a new
;           name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]". A
;           custom theme can't use the name of a built-in theme.
;   Step 3: Change the colours (#RRGGBB, or transparent).
;   Step 4: Keep "version=2". A theme file without it, or with another
;           version, is skipped.
;=============================================================================
[Taskmon Default]
version=2
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#00FFFF
control.background.highlight.inactive=#708090
control.foreground=#FFFFFF
control.foreground.highlight.focused=#000000
control.foreground.highlight.inactive=#000000
control.border=#FFFFFF
control.border.focused=#FFFF00

chart.background=transparent
chart.borderforeground=#FFFFFF
chart.borderbackground=transparent
chart.yaxis=#00FF00
chart.title=#FFFFFF
chart.grid=#A9A9A9
chart.range.low.background=#00FF00
chart.range.low.foreground=#000000
chart.range.mid.background=#FFFF00
chart.range.mid.foreground=#000000
chart.range.high.background=#FF0000
chart.range.high.foreground=#000000

metre.background=transparent
metre.foreground=#FFFFFF
metre.borderforeground=#FFFFFF
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#FFFFFF
listview.borderforeground=#FFFFFF
listview.borderbackground=transparent
listview.header.background=#008000
listview.header.foreground=#000000

dialog.background=#008000
dialog.foreground=#000000
dialog.border=#000000
dialog.button.background=#00FFFF
dialog.button.foreground=#000000
dialog.button.focus=#ff0000
dialog.list.background=#4ca64c
dialog.list.foreground=#000000

performance.panel.background=transparent
performance.panel.foreground=#FFFFFF
performance.panel.titlebar.background=#000080
performance.panel.titlebar.foreground=#000000
performance.cpu.kernel=#FF0000
performance.cpu.user=#00FF00
performance.memory.inuse=#FF0000
performance.memory.modified=#00FF00
performance.memory.standby=#FFFF00
performance.memory.free=#00FF00

property.key=#0000FF
property.value=#FFFFFF

process.list.normaluserspace=#00FF00
process.list.lowpriority=#0000FF
process.list.highcpu=#FF0000
process.list.iobound=#00FFFF
process.list.script=#FFFF00
process.list.user.currentnonroot=#00FF00
process.list.user.othernonroot=#FF00FF
process.list.user.system=#C0C0C0
process.list.user.root=#FFFFFF
process.list.deltahighlight=#FFFF00

heatmap.state.scanning=#FFFF00
heatmap.state.completed=#00FF00
heatmap.state.faulted=#FF0000

app.error=#FF0000

status.ok=#00FF00
status.warning=#FFFF00
status.error=#FF0000

menubar.foreground=#000000
menubar.background=#000080

command.foreground=#000000
command.background=#00FFFF
command.foreground.disabled=#808080

statusbar.banner.background=#00FFFF
statusbar.banner.foreground=#000000
statusbar.status.foreground=#000000
statusbar.status.ok=#008000
statusbar.status.warning=#ffa500
statusbar.status.error=#ff4500
statusbar.pulse=#00bfff
statusbar.health.ok.background=#00FF00
statusbar.health.ok.foreground=#000000
statusbar.health.warning.background=#FFFF00
statusbar.health.warning.foreground=#000000
statusbar.health.critical.background=#FF0000
statusbar.health.critical.foreground=#000000
statusbar.health.unknown.background=#808080
statusbar.health.unknown.foreground=#000000

hotkey.key=#00BFFF
hotkey.name=#FFFFFF

tip.glyph=#FFA500
