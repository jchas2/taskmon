;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[Alien Blood]
colour-mode=truecolour

control.background=#0f1610
control.background.highlight.focused=#1d4125
control.background.highlight.inactive=#708090
control.foreground=#717f24
control.foreground.highlight.focused=#73fa91
control.foreground.highlight.inactive=#73fa91
control.border=#717f24
control.border.focused=#ffd085

chart.border=#717f24
chart.yaxis=#327f77
chart.title=#717f24
chart.grid=#A9A9A9
chart.range.low.background=#10b981
chart.range.low.foreground=#000000
chart.range.mid.background=#ffd085
chart.range.mid.foreground=#000000
chart.range.high.background=#b082d1
chart.range.high.foreground=#000000

listview.background=#0f1610
listview.foreground=#717f24
listview.border=#717f24
listview.header.background=#121d18
listview.header.foreground=#717f24

performance.panel.background=#0f1610
performance.panel.foreground=#717f24
performance.panel.titlebar.background=#121d18
performance.panel.titlebar.foreground=#717f24
performance.cpu.kernel=#b082d1
performance.cpu.user=#327f77
performance.memory.inuse=#b082d1
performance.memory.modified=#327f77
performance.memory.standby=#ffd085
performance.memory.free=#10b981

process.list.normaluserspace=#327f77
process.list.lowpriority=#10b981
process.list.highcpu=#b082d1
process.list.iobound=#dff0e6
process.list.script=#dff0e6
process.list.user.currentnonroot=#b082d1
process.list.user.othernonroot=#b082d1
process.list.user.system=#73fa91
process.list.user.root=#73fa91
process.list.deltahighlight=#bda25c

heatmap.size.small=#10b981
heatmap.size.mid=#ffd085
heatmap.size.large=#b082d1
heatmap.state.scanning=#000000
heatmap.state.completed=#000000
heatmap.state.faulted=#000000

app.error=#a6423f

menubar.foreground=#717f24
menubar.background=#121d18

command.foreground=#717f24
command.background=#121d18
