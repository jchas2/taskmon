;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; This is a reference copy of a theme built into taskmon. taskmon doesn't
; load it, and puts it back as shipped each time it starts, so any changes
; made here are lost.
;
; How to create a custom theme:
;   Step 1: Copy this file into the themes folder, one level up, under a new
;           name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]". A
;           custom theme can't use the name of a built-in theme.
;   Step 3: Change the colours (#RRGGBB, or transparent).
;   Step 4: Keep "version=2". A theme file without it, or with another
;           version, is skipped.
;=============================================================================
[Windows XP]
version=2
colour-mode=truecolour

control.background=#ece9d8
control.background.highlight.focused=#316ac5
control.background.highlight.inactive=#ece9d8
control.foreground=#000000
control.foreground.highlight.focused=#ffffff
control.foreground.highlight.inactive=#000000
control.border=#7f9db9
control.border.focused=#e68b2c

chart.background=#000000
chart.borderforeground=#7f9db9
chart.borderbackground=#ece9d8
chart.yaxis=#00ff00
chart.title=#0046d5
chart.grid=#008040
chart.range.low.background=#00ff00
chart.range.low.foreground=#000000
chart.range.mid.background=#ffff00
chart.range.mid.foreground=#000000
chart.range.high.background=#ff0000
chart.range.high.foreground=#000000

metre.background=#000000
metre.foreground=#00ff00
metre.borderforeground=#7f9db9
metre.borderbackground=#ece9d8

listview.background=#ffffff
listview.foreground=#000000
listview.borderforeground=#7f9db9
listview.borderbackground=#ece9d8
listview.header.background=#ebeadb
listview.header.foreground=#000000

dialog.background=#ece9d8
dialog.foreground=#000000
dialog.border=#0054e3
dialog.button.background=#0054e3
dialog.button.foreground=#ffffff
dialog.button.focus=#e68b2c
dialog.list.background=#ffffff
dialog.list.foreground=#000000

performance.panel.background=#ece9d8
performance.panel.foreground=#000000
performance.panel.titlebar.background=#0054e3
performance.panel.titlebar.foreground=#ffffff
performance.cpu.kernel=#ff0000
performance.cpu.user=#ffff00
performance.memory.inuse=#ff0000
performance.memory.modified=#ffff00
performance.memory.standby=#3a93ff
performance.memory.free=#00ff00

property.key=#0046d5
property.value=#000000

process.list.normaluserspace=#000000
process.list.lowpriority=#716f64
process.list.highcpu=#c00000
process.list.iobound=#a65e00
process.list.script=#257525
process.list.user.currentnonroot=#257525
process.list.user.othernonroot=#7a3e9d
process.list.user.system=#716f64
process.list.user.root=#8b0000
process.list.deltahighlight=#0066cc

heatmap.state.scanning=#a65e00
heatmap.state.completed=#257525
heatmap.state.faulted=#c00000

app.error=#c00000

status.ok=#257525
status.warning=#a65e00
status.error=#c00000

menubar.foreground=#ffffff
menubar.background=#0054e3

command.foreground=#ffffff
command.background=#245edb
command.foreground.disabled=#aca899

statusbar.banner.background=#316ac5
statusbar.banner.foreground=#ffffff
statusbar.status.foreground=#000000
statusbar.status.ok=#008000
statusbar.status.warning=#ffa500
statusbar.status.error=#ff4500
statusbar.pulse=#00bfff
statusbar.health.ok.background=#257525
statusbar.health.ok.foreground=#ffffff
statusbar.health.warning.background=#a65e00
statusbar.health.warning.foreground=#ffffff
statusbar.health.critical.background=#c00000
statusbar.health.critical.foreground=#ffffff
statusbar.health.unknown.background=#aca899
statusbar.health.unknown.foreground=#000000

hotkey.key=#0046d5
hotkey.name=#000000

tip.glyph=#a65e00
