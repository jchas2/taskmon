;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[Catppuccin]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#3b5070
control.background.highlight.inactive=#708090
control.foreground=#a6e3a1
control.foreground.highlight.focused=#eba0ac
control.foreground.highlight.inactive=#eba0ac
control.border=#a6e3a1
control.border.focused=#fab387

chart.background=transparent
chart.borderforeground=#a6e3a1
chart.borderbackground=transparent
chart.yaxis=#89b4fa
chart.title=#a6e3a1
chart.grid=#A9A9A9
chart.range.low.background=#a6e3a1
chart.range.low.foreground=#000000
chart.range.mid.background=#fab387
chart.range.mid.foreground=#000000
chart.range.high.background=#cba6f7
chart.range.high.foreground=#000000

metre.background=transparent
metre.foreground=#a6e3a1
metre.borderforeground=#a6e3a1
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#a6e3a1
listview.borderforeground=#a6e3a1
listview.borderbackground=transparent
listview.header.background=#1e1e2e
listview.header.foreground=#a6e3a1

performance.panel.background=transparent
performance.panel.foreground=#a6e3a1
performance.panel.titlebar.background=#1e1e2e
performance.panel.titlebar.foreground=#a6e3a1
performance.cpu.kernel=#cba6f7
performance.cpu.user=#89b4fa
performance.memory.inuse=#cba6f7
performance.memory.modified=#89b4fa
performance.memory.standby=#fab387
performance.memory.free=#a6e3a1

property.key=#a6e3a1
property.value=#a6e3a1

process.list.normaluserspace=#89b4fa
process.list.lowpriority=#0000FF
process.list.highcpu=#cba6f7
process.list.iobound=#2b7489
process.list.script=#e3b341
process.list.user.currentnonroot=#cdd6f4
process.list.user.othernonroot=#a6e3a1
process.list.user.system=#cba6f7
process.list.user.root=#89b4fa
process.list.deltahighlight=#fab387

heatmap.size.small=#a6e3a1
heatmap.size.mid=#fab387
heatmap.size.large=#cba6f7
heatmap.state.scanning=#000000
heatmap.state.completed=#000000
heatmap.state.faulted=#000000

app.error=#db61a2

menubar.foreground=#a6e3a1
menubar.background=#1e1e2e

command.foreground=#a6e3a1
command.background=#1e1e2e
