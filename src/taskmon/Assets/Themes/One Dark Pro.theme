;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[One Dark Pro]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=##3b5070
control.background.highlight.inactive=#708090
control.foreground=#98c379
control.foreground.highlight.focused=#e06c75
control.foreground.highlight.inactive=#e06c75
control.border=#98c379
control.border.focused=#d19a66

chart.background=transparent
chart.borderforeground=#98c379
chart.borderbackground=transparent
chart.yaxis=#61afef
chart.title=#98c379
chart.grid=#A9A9A9
chart.range.low.background=#98c379
chart.range.low.foreground=#222222
chart.range.mid.background=#d19a66
chart.range.mid.foreground=#222222
chart.range.high.background=#c678dd
chart.range.high.foreground=#222222

metre.background=transparent
metre.foreground=#98c379
metre.borderforeground=#98c379
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#98c379
listview.borderforeground=#98c379
listview.borderbackground=transparent
listview.header.background=#282c34
listview.header.foreground=#98c379

performance.panel.background=transparent
performance.panel.foreground=#98c379
performance.panel.titlebar.background=#282c34
performance.panel.titlebar.foreground=#98c379
performance.cpu.kernel=#c678dd
performance.cpu.user=#61afef
performance.memory.inuse=#c678dd
performance.memory.modified=#61afef
performance.memory.standby=#d19a66
performance.memory.free=#98c379

property.key=#98c379
property.value=#98c379

process.list.normaluserspace=#61afef
process.list.lowpriority=#0000FF
process.list.highcpu=#c678dd
process.list.iobound=#2b7489
process.list.script=#e3b341
process.list.user.currentnonroot=#61afef
process.list.user.othernonroot=#98c379
process.list.user.system=#c678dd
process.list.user.root=#e06c75
process.list.deltahighlight=#d19a66

heatmap.size.small=#98c379
heatmap.size.mid=#d19a66
heatmap.size.large=#c678dd
heatmap.state.scanning=#222222
heatmap.state.completed=#222222
heatmap.state.faulted=#222222

app.error=#db61a2

menubar.foreground=#98c379
menubar.background=#282c34

command.foreground=#98c379
command.background=#282c34
