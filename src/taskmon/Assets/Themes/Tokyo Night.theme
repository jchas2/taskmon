;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; This is a reference copy of a theme built into taskmon. taskmon doesn't
; load it, and puts it back as shipped each time it starts, so any changes
; made here are lost.
;
; How to create a custom theme:
;   Step 1: Copy this file into the themes folder, one level up, under a new
;           name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]". A
;           custom theme can't use the name of a built-in theme.
;   Step 3: Change the colours (#RRGGBB, or transparent).
;   Step 4: Keep "version=2". A theme file without it, or with another
;           version, is skipped.
;=============================================================================
[Tokyo Night]
version=2
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#3b5070
control.background.highlight.inactive=#708090
control.foreground=#a9b1d6
control.foreground.highlight.focused=#c0caf5
control.foreground.highlight.inactive=#c0caf5
control.border=#a9b1d6
control.border.focused=#ff9e64

chart.background=transparent
chart.borderforeground=#a9b1d6
chart.borderbackground=transparent
chart.yaxis=#9ece6a
chart.title=#a9b1d6
chart.grid=#A9A9A9
chart.range.low.background=#9ece6a
chart.range.low.foreground=#000000
chart.range.mid.background=#bb9af7  
chart.range.mid.foreground=#000000
chart.range.high.background=#ff9e64
chart.range.high.foreground=#000000

metre.background=transparent
metre.foreground=#a9b1d6
metre.borderforeground=#a9b1d6
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#a9b1d6
listview.borderforeground=#a9b1d6
listview.borderbackground=transparent
listview.header.background=#1a1b26
listview.header.foreground=#9ece6a

dialog.background=#1a1b26
dialog.foreground=#9ece6a
dialog.border=#9ece6a
dialog.button.background=#3b5070
dialog.button.foreground=#c0caf5
dialog.button.focus=#ff0000
dialog.list.background=#101118
dialog.list.foreground=#9ece6a

performance.panel.background=transparent
performance.panel.foreground=#a9b1d6
performance.panel.titlebar.background=#1a1b26
performance.panel.titlebar.foreground=#9ece6a
performance.cpu.kernel=#bb9af7
performance.cpu.user=#9ece6a
performance.memory.inuse=#bb9af7
performance.memory.modified=#9ece6a
performance.memory.standby=#ff9e64
performance.memory.free=#9ece6a

property.key=#9ece6a
property.value=#a9b1d6

process.list.normaluserspace=#9ece6a
process.list.lowpriority=#0000FF
process.list.highcpu=#bb9af7
process.list.iobound=#2b7489
process.list.script=#e3b341
process.list.user.currentnonroot=#a9b1d6
process.list.user.othernonroot=#9ece6a
process.list.user.system=#bb9af7
process.list.user.root=#7aa2f7
process.list.deltahighlight=#ff9e64

heatmap.state.scanning=#bb9af7
heatmap.state.completed=#9ece6a
heatmap.state.faulted=#ff9e64

app.error=#db61a2

status.ok=#9ece6a
status.warning=#bb9af7
status.error=#ff9e64

menubar.foreground=#9ece6a
menubar.background=#1a1b26

command.foreground=#9ece6a
command.background=#1a1b26
command.foreground.disabled=#808080

statusbar.banner.background=#3b5070
statusbar.banner.foreground=#c0caf5
statusbar.status.foreground=#000000
statusbar.status.ok=#008000
statusbar.status.warning=#ffa500
statusbar.status.error=#ff4500
statusbar.pulse=#00bfff
statusbar.health.ok.background=#9ece6a
statusbar.health.ok.foreground=#000000
statusbar.health.warning.background=#bb9af7
statusbar.health.warning.foreground=#000000
statusbar.health.critical.background=#ff9e64
statusbar.health.critical.foreground=#000000
statusbar.health.unknown.background=#808080
statusbar.health.unknown.foreground=#000000

hotkey.key=#00BFFF
hotkey.name=#a9b1d6

tip.glyph=#FFA500
