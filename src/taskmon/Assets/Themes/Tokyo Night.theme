;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[Tokyo Night]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#3b5070
control.background.highlight.inactive=#708090
control.foreground=#a9b1d6
control.foreground.highlight.focused=#c0caf5
control.foreground.highlight.inactive=#c0caf5
control.border=#a9b1d6
control.border.focused=#ff9e64

chart.background=transparent
chart.borderforeground=#a9b1d6
chart.borderbackground=transparent
chart.yaxis=#9ece6a
chart.title=#a9b1d6
chart.grid=#A9A9A9
chart.range.low.background=#9ece6a
chart.range.low.foreground=#000000
chart.range.mid.background=#ff9e64
chart.range.mid.foreground=#000000
chart.range.high.background=#bb9af7
chart.range.high.foreground=#000000

metre.background=transparent
metre.foreground=#a9b1d6
metre.borderforeground=#a9b1d6
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#a9b1d6
listview.borderforeground=#a9b1d6
listview.borderbackground=transparent
listview.header.background=#1a1b26
listview.header.foreground=#9ece6a

performance.panel.background=transparent
performance.panel.foreground=#a9b1d6
performance.panel.titlebar.background=#1a1b26
performance.panel.titlebar.foreground=#9ece6a
performance.cpu.kernel=#bb9af7
performance.cpu.user=#9ece6a
performance.memory.inuse=#bb9af7
performance.memory.modified=#9ece6a
performance.memory.standby=#ff9e64
performance.memory.free=#9ece6a

property.key=#a9b1d6
property.value=#a9b1d6

process.list.normaluserspace=#9ece6a
process.list.lowpriority=#0000FF
process.list.highcpu=#bb9af7
process.list.iobound=#2b7489
process.list.script=#e3b341
process.list.user.currentnonroot=#a9b1d6
process.list.user.othernonroot=#9ece6a
process.list.user.system=#bb9af7
process.list.user.root=#7aa2f7
process.list.deltahighlight=#ff9e64

heatmap.size.small=#9ece6a
heatmap.size.mid=#ff9e64
heatmap.size.large=#bb9af7
heatmap.state.scanning=#000000
heatmap.state.completed=#000000
heatmap.state.faulted=#000000

app.error=#db61a2

menubar.foreground=#9ece6a
menubar.background=#1a1b26

command.foreground=#9ece6a
command.background=#1a1b26
