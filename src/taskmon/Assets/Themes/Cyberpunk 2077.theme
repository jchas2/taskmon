;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; This is a reference copy of a theme built into taskmon. taskmon doesn't
; load it, and puts it back as shipped each time it starts, so any changes
; made here are lost.
;
; How to create a custom theme:
;   Step 1: Copy this file into the themes folder, one level up, under a new
;           name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]". A
;           custom theme can't use the name of a built-in theme.
;   Step 3: Change the colours (#RRGGBB, or transparent).
;   Step 4: Keep "version=2". A theme file without it, or with another
;           version, is skipped.
;=============================================================================
[Cyberpunk 2077]
version=2
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#6272A4
control.background.highlight.inactive=#708090
control.foreground=#37EBF3
control.foreground.highlight.focused=#ffffff
control.foreground.highlight.inactive=#ffffff
control.border=#E455AE
control.border.focused=#FDF500

chart.background=transparent
chart.borderforeground=#E455AE
chart.borderbackground=transparent
chart.yaxis=#FDF500
chart.title=#E455AE
chart.grid=#A9A9A9
chart.range.low.background=#6272A4
chart.range.low.foreground=#222222
chart.range.mid.background=#4CAEDB
chart.range.mid.foreground=#222222
chart.range.high.background=#37EBF3
chart.range.high.foreground=#222222

metre.background=transparent
metre.foreground=#E455AE
metre.borderforeground=#E455AE
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#37EBF3
listview.borderforeground=#E455AE
listview.borderbackground=transparent
listview.header.background=#37EBF350
listview.header.foreground=#000000

dialog.background=#37EBF350
dialog.foreground=#000000
dialog.border=#000000
dialog.button.background=#6272A4
dialog.button.foreground=#ffffff

performance.panel.background=transparent
performance.panel.foreground=#37EBF3
performance.panel.titlebar.background=#37EBF350
performance.panel.titlebar.foreground=#000000
performance.cpu.kernel=#37EBF3
performance.cpu.user=#FDF500
performance.memory.inuse=#37EBF3
performance.memory.modified=#FDF500
performance.memory.standby=#4CAEDB
performance.memory.free=#6272A4

property.key=#37EBF350
property.value=#37EBF3

process.list.normaluserspace=#FDF500
process.list.lowpriority=#37EBF3
process.list.highcpu=#37EBF3
process.list.iobound=#0E79B2
process.list.script=#E455AE
process.list.user.currentnonroot=#6272A4
process.list.user.othernonroot=#2CF6B3
process.list.user.system=#2CF6B3
process.list.user.root=#2CF6B3
process.list.deltahighlight=#6272A4

heatmap.state.scanning=#222222
heatmap.state.completed=#222222
heatmap.state.faulted=#222222

app.error=#db61a2

status.ok=#6272A4
status.warning=#4CAEDB
status.error=#37EBF3

menubar.foreground=#000000
menubar.background=#37EBF350

command.foreground=#000000
command.background=#37EBF350
command.foreground.disabled=#808080

statusbar.banner.background=#00bfff
statusbar.banner.foreground=#000000
statusbar.status.foreground=#000000
statusbar.status.ok=#008000
statusbar.status.warning=#ffa500
statusbar.status.error=#ff4500
statusbar.pulse=#00bfff

hotkey.key=#00BFFF
hotkey.name=#E455AE

tip.glyph=#FFA500
