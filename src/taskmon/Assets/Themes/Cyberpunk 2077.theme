;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[Cyberpunk 2077]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#6272A4
control.background.highlight.inactive=#708090
control.foreground=#E455AE
control.foreground.highlight.focused=#ffffff
control.foreground.highlight.inactive=#ffffff
control.border=#E455AE
control.border.focused=#FDF500

chart.border=#E455AE
chart.yaxis=#FDF500
chart.title=#E455AE
chart.grid=#A9A9A9
chart.range.low.background=#6272A4
chart.range.low.foreground=#222222
chart.range.mid.background=#4CAEDB
chart.range.mid.foreground=#222222
chart.range.high.background=#37EBF3
chart.range.high.foreground=#222222

listview.background=transparent
listview.foreground=#E455AE
listview.border=#E455AE
listview.header.background=#37EBF350
listview.header.foreground=#000000

performance.panel.background=transparent
performance.panel.foreground=#E455AE
performance.panel.titlebar.background=#37EBF350
performance.panel.titlebar.foreground=#000000
performance.cpu.kernel=#37EBF3
performance.cpu.user=#FDF500
performance.memory.inuse=#37EBF3
performance.memory.modified=#FDF500
performance.memory.standby=#4CAEDB
performance.memory.free=#6272A4

process.list.normaluserspace=#FDF500
process.list.lowpriority=#37EBF3
process.list.highcpu=#37EBF3
process.list.iobound=#0E79B2
process.list.script=#E455AE
process.list.user.currentnonroot=#6272A4
process.list.user.othernonroot=#2CF6B3
process.list.user.system=#2CF6B3
process.list.user.root=#2CF6B3
process.list.deltahighlight=#6272A4

heatmap.size.small=#6272A4
heatmap.size.mid=#4CAEDB
heatmap.size.large=#37EBF3
heatmap.state.scanning=#222222
heatmap.state.completed=#222222
heatmap.state.faulted=#222222

app.error=#db61a2

menubar.foreground=#000000
menubar.background=#37EBF350

command.foreground=#000000
command.background=#37EBF350
