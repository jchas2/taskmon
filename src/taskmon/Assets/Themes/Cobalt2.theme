;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[Cobalt2]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#0050A4
control.background.highlight.inactive=#708090
control.foreground=#ffc600
control.foreground.highlight.focused=#ffffff21
control.foreground.highlight.inactive=#ffffff21
control.border=#ffc600
control.border.focused=#ff9d00

chart.background=transparent
chart.borderforeground=#ffc600
chart.borderbackground=transparent
chart.yaxis=#a5ff90
chart.title=#ffc600
chart.grid=#A9A9A9
chart.range.low.background=#0088ff
chart.range.low.foreground=#222222
chart.range.mid.background=#ff9d00
chart.range.mid.foreground=#222222
chart.range.high.background=#ba55d3
chart.range.high.foreground=#222222

metre.background=transparent
metre.foreground=#ffc600
metre.borderforeground=#ffc600
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#ffc600
listview.borderforeground=#ffc600
listview.borderbackground=transparent
listview.header.background=#193549
listview.header.foreground=#e1efff

performance.panel.background=transparent
performance.panel.foreground=#ffc600
performance.panel.titlebar.background=#193549
performance.panel.titlebar.foreground=#e1efff
performance.cpu.kernel=#ba55d3
performance.cpu.user=#a5ff90
performance.memory.inuse=#ba55d3
performance.memory.modified=#a5ff90
performance.memory.standby=#ff9d00
performance.memory.free=#0088ff

property.key=#ffc600
property.value=#ffc600

process.list.normaluserspace=#a5ff90
process.list.lowpriority=#ff628c
process.list.highcpu=#ba55d3
process.list.iobound=#e1efff
process.list.script=#80ffbb
process.list.user.currentnonroot=#0088ff
process.list.user.othernonroot=#ff9d00
process.list.user.system=#e1efff
process.list.user.root=#e1efff
process.list.deltahighlight=#9effff

heatmap.size.small=#0088ff
heatmap.size.mid=#ff9d00
heatmap.size.large=#ba55d3
heatmap.state.scanning=#222222
heatmap.state.completed=#222222
heatmap.state.faulted=#222222

app.error=#db61a2

menubar.foreground=#e1efff
menubar.background=#193549

command.foreground=#e1efff
command.background=#193549
