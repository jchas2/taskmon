;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[Monochrome]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#808080
control.background.highlight.inactive=#708090
control.foreground=#ffffff
control.foreground.highlight.focused=#ffffff
control.foreground.highlight.inactive=#ffffff
control.border=#ffffff
control.border.focused=#c0c0c0

chart.background=transparent
chart.borderforeground=#ffffff
chart.borderbackground=transparent
chart.yaxis=#ffffff
chart.title=#ffffff
chart.grid=#A9A9A9
chart.range.low.background=#c0c0c0
chart.range.low.foreground=#808080
chart.range.mid.background=#c0c0c0
chart.range.mid.foreground=#808080
chart.range.high.background=#c0c0c0
chart.range.high.foreground=#808080

metre.background=transparent
metre.foreground=#ffffff
metre.borderforeground=#ffffff
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#ffffff
listview.borderforeground=#ffffff
listview.borderbackground=transparent
listview.header.background=#c0c0c0
listview.header.foreground=#000000

performance.panel.background=transparent
performance.panel.foreground=#ffffff
performance.panel.titlebar.background=#c0c0c0
performance.panel.titlebar.foreground=#000000
performance.cpu.kernel=#c0c0c0
performance.cpu.user=#ffffff
performance.memory.inuse=#c0c0c0
performance.memory.modified=#ffffff
performance.memory.standby=#c0c0c0
performance.memory.free=#c0c0c0

property.key=#ffffff
property.value=#ffffff

process.list.normaluserspace=#ffffff
process.list.lowpriority=#ffffff
process.list.highcpu=#ffffff
process.list.iobound=#ffffff
process.list.script=#ffffff
process.list.user.currentnonroot=#ffffff
process.list.user.othernonroot=#ffffff
process.list.user.system=#ffffff
process.list.user.root=#ffffff
process.list.deltahighlight=#ffffff

heatmap.size.small=#c0c0c0
heatmap.size.mid=#c0c0c0
heatmap.size.large=#c0c0c0
heatmap.state.scanning=#808080
heatmap.state.completed=#808080
heatmap.state.faulted=#808080

app.error=#ffffff

menubar.foreground=#000000
menubar.background=#c0c0c0

command.foreground=#000000
command.background=#c0c0c0
