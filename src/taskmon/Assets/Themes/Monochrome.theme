[Monochrome]
colour-mode=indexed

background=transparent
background-highlight=#808080

col-cmd-normal-user-space=#c0c0c0
col-cmd-low-priority=#808080
col-cmd-high-cpu=#ffffff
col-cmd-io-bound=#ffffff
col-cmd-script=#808080
col-user-current-non-root=#f8f8f2
col-user-other-non-root=#808080
col-user-system=#c0c0c0
col-user-root=#ffffff

command-foreground=#000000
command-background=#c0c0c0

delta-highlight-colour=#ffffff

error=#c0c0c0

foreground=#808080
foreground-highlight=#ffffff

menubar-foreground=#000000
menubar-background=#c0c0c0

range-high-background=#c0c0c0
range-low-background=#c0c0c0
range-mid-background=#c0c0c0
range-high-foreground=#808080
range-low-foreground=#808080
range-mid-foreground=#808080

header-background=#c0c0c0
header-foreground=#000000
