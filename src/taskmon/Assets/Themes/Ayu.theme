;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[Ayu]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#3b5070
control.background.highlight.inactive=#708090
control.foreground=#bae67e
control.foreground.highlight.focused=#95e6cb
control.foreground.highlight.inactive=#95e6cb
control.border=#bae67e
control.border.focused=#ffa759

chart.background=transparent
chart.borderforeground=#bae67e
chart.borderbackground=transparent
chart.yaxis=#59a6e0
chart.title=#bae67e
chart.grid=#A9A9A9
chart.range.low.background=#bae67e
chart.range.low.foreground=#000000
chart.range.mid.background=#ffa759
chart.range.mid.foreground=#000000
chart.range.high.background=#ffa759
chart.range.high.foreground=#000000

metre.background=transparent
metre.foreground=#bae67e
metre.borderforeground=#bae67e
metre.borderbackground=transparent

listview.background=transparent
listview.foreground=#bae67e
listview.borderforeground=#bae67e
listview.borderbackground=transparent
listview.header.background=#1f2430
listview.header.foreground=#bae67e

performance.panel.background=transparent
performance.panel.foreground=#bae67e
performance.panel.titlebar.background=#1f2430
performance.panel.titlebar.foreground=#bae67e
performance.cpu.kernel=#ffa759
performance.cpu.user=#59a6e0
performance.memory.inuse=#ffa759
performance.memory.modified=#59a6e0
performance.memory.standby=#ffa759
performance.memory.free=#bae67e

property.key=#bae67e
property.value=#bae67e

process.list.normaluserspace=#59a6e0
process.list.lowpriority=#0000FF
process.list.highcpu=#ffa759
process.list.iobound=#2b7489
process.list.script=#e3b341
process.list.user.currentnonroot=#95e6cb
process.list.user.othernonroot=#bae67e
process.list.user.system=#ffa759
process.list.user.root=#ffd580
process.list.deltahighlight=#ffa759

heatmap.size.small=#bae67e
heatmap.size.mid=#ffa759
heatmap.size.large=#ffa759
heatmap.state.scanning=#000000
heatmap.state.completed=#000000
heatmap.state.faulted=#000000

app.error=#db61a2

menubar.foreground=#bae67e
menubar.background=#1f2430

command.foreground=#bae67e
command.background=#1f2430
