;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[MS-DOS]
colour-mode=truecolour

control.background=#000080
control.background.highlight.focused=#00FFFF
control.background.highlight.inactive=#708090
control.foreground=#808080
control.foreground.highlight.focused=#000000
control.foreground.highlight.inactive=#000000
control.border=#808080
control.border.focused=#FFFF00

chart.background=#000080
chart.borderforeground=#808080
chart.borderbackground=#000080
chart.yaxis=#FFFF00
chart.title=#808080
chart.grid=#A9A9A9
chart.range.low.background=#00FF00
chart.range.low.foreground=#000000
chart.range.mid.background=#FFFF00
chart.range.mid.foreground=#000000
chart.range.high.background=#FF0000
chart.range.high.foreground=#000000

metre.background=#000080
metre.foreground=#808080
metre.borderforeground=#808080
metre.borderbackground=#000080

listview.background=#000080
listview.foreground=#808080
listview.borderforeground=#808080
listview.borderbackground=#000080
listview.header.background=#008080
listview.header.foreground=#FFFF00

performance.panel.background=#000080
performance.panel.foreground=#808080
performance.panel.titlebar.background=#008080
performance.panel.titlebar.foreground=#FFFF00
performance.cpu.kernel=#FF0000
performance.cpu.user=#FFFF00
performance.memory.inuse=#FF0000
performance.memory.modified=#FFFF00
performance.memory.standby=#FFFF00
performance.memory.free=#00FF00

property.key=#808080
property.value=#808080

process.list.normaluserspace=#FFFF00
process.list.lowpriority=#C0C0C0
process.list.highcpu=#FF0000
process.list.iobound=#FF0000
process.list.script=#FFFF00
process.list.user.currentnonroot=#C0C0C0
process.list.user.othernonroot=#808080
process.list.user.system=#FFFF00
process.list.user.root=#FF0000
process.list.deltahighlight=#FFFF00

heatmap.size.small=#00FF00
heatmap.size.mid=#FFFF00
heatmap.size.large=#FF0000
heatmap.state.scanning=#000000
heatmap.state.completed=#000000
heatmap.state.faulted=#000000

app.error=#FF0000

menubar.foreground=#FFFF00
menubar.background=#008080

command.foreground=#FFFF00
command.background=#008080
