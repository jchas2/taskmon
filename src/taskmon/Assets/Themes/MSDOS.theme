;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; This is a reference copy of a theme built into taskmon. taskmon doesn't
; load it, and puts it back as shipped each time it starts, so any changes
; made here are lost.
;
; How to create a custom theme:
;   Step 1: Copy this file into the themes folder, one level up, under a new
;           name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]". A
;           custom theme can't use the name of a built-in theme.
;   Step 3: Change the colours (#RRGGBB, or transparent).
;   Step 4: Keep "version=2". A theme file without it, or with another
;           version, is skipped.
;=============================================================================
[MS-DOS]
version=2
colour-mode=truecolour

control.background=#0000aa
control.background.highlight.focused=#00aaaa
control.background.highlight.inactive=#aaaaaa
control.foreground=#aaaaaa
control.foreground.highlight.focused=#000000
control.foreground.highlight.inactive=#0000aa
control.border=#aaaaaa
control.border.focused=#ffffff

chart.background=#0000aa
chart.borderforeground=#aaaaaa
chart.borderbackground=#0000aa
chart.yaxis=#55ffff
chart.title=#ffffff
chart.grid=#5555ff
chart.range.low.background=#55ff55
chart.range.low.foreground=#000000
chart.range.mid.background=#ffff55
chart.range.mid.foreground=#000000
chart.range.high.background=#ff5555
chart.range.high.foreground=#000000

metre.background=#0000aa
metre.foreground=#55ffff
metre.borderforeground=#aaaaaa
metre.borderbackground=#0000aa

listview.background=#0000aa
listview.foreground=#aaaaaa
listview.borderforeground=#aaaaaa
listview.borderbackground=#0000aa
listview.header.background=#0000aa
listview.header.foreground=#ffff55

dialog.background=#aaaaaa
dialog.foreground=#000000
dialog.border=#ffffff
dialog.button.background=#00aa00
dialog.button.foreground=#000000
dialog.button.focus=#ffffff
dialog.list.background=#0000aa
dialog.list.foreground=#aaaaaa

performance.panel.background=#0000aa
performance.panel.foreground=#aaaaaa
performance.panel.titlebar.background=#aaaaaa
performance.panel.titlebar.foreground=#000000
performance.cpu.kernel=#ff5555
performance.cpu.user=#ffff55
performance.memory.inuse=#ff5555
performance.memory.modified=#ffff55
performance.memory.standby=#55ffff
performance.memory.free=#55ff55

property.key=#ffff55
property.value=#ffffff

process.list.normaluserspace=#aaaaaa
process.list.lowpriority=#00aaaa
process.list.highcpu=#ff5555
process.list.iobound=#ffff55
process.list.script=#55ff55
process.list.user.currentnonroot=#55ff55
process.list.user.othernonroot=#55ffff
process.list.user.system=#00aaaa
process.list.user.root=#ff5555
process.list.deltahighlight=#ffffff

heatmap.state.scanning=#ffff55
heatmap.state.completed=#55ff55
heatmap.state.faulted=#ff5555

app.error=#ff5555

status.ok=#55ff55
status.warning=#ffff55
status.error=#ff5555

menubar.foreground=#000000
menubar.background=#aaaaaa

command.foreground=#000000
command.background=#aaaaaa
command.foreground.disabled=#555555

statusbar.banner.background=#00aaaa
statusbar.banner.foreground=#000000
statusbar.status.foreground=#000000
statusbar.status.ok=#008000
statusbar.status.warning=#ffa500
statusbar.status.error=#ff4500
statusbar.pulse=#00bfff
statusbar.health.ok.background=#55ff55
statusbar.health.ok.foreground=#000000
statusbar.health.warning.background=#ffff55
statusbar.health.warning.foreground=#000000
statusbar.health.critical.background=#ff5555
statusbar.health.critical.foreground=#000000
statusbar.health.unknown.background=#555555
statusbar.health.unknown.foreground=#ffffff

hotkey.key=#ffff55
hotkey.name=#aaaaaa

tip.glyph=#ffff55
