;=============================================================================
; Task Monitor (taskmon) - Built-in Theme
;=============================================================================
; IMPORTANT:
; Any modifications to default/shipped theme files will be reset automatically
; when taskmon runs or updates.
;
; How to create a custom theme:
;   Step 1: Copy this file to a new name (e.g. "Tokyo Night Custom.theme").
;   Step 2: Rename the header "[Tokyo Night]" to "[Tokyo Night Custom]".
;   Step 3: Customize color hex values (#RRGGBB).
;=============================================================================
[Dracula Official]
colour-mode=indexed

control.background=transparent
control.background.highlight.focused=#3b5070
control.background.highlight.inactive=#708090
control.foreground=#f8f8f2
control.foreground.highlight.focused=#ffb86c
control.foreground.highlight.inactive=#ffb86c
control.border=#f8f8f2
control.border.focused=#ff79c6

chart.border=#f8f8f2
chart.yaxis=#50fa7b
chart.title=#f8f8f2
chart.grid=#A9A9A9
chart.range.low.background=#f1fa8c
chart.range.low.foreground=#000000
chart.range.mid.background=#ffb86c
chart.range.mid.foreground=#000000
chart.range.high.background=#bd93f9
chart.range.high.foreground=#000000

listview.background=transparent
listview.foreground=#f8f8f2
listview.border=#f8f8f2
listview.header.background=#282a36
listview.header.foreground=#f1fa8c

performance.panel.background=transparent
performance.panel.foreground=#f8f8f2
performance.panel.titlebar.background=#282a36
performance.panel.titlebar.foreground=#f1fa8c
performance.cpu.kernel=#bd93f9
performance.cpu.user=#50fa7b
performance.memory.inuse=#bd93f9
performance.memory.modified=#50fa7b
performance.memory.standby=#ffb86c
performance.memory.free=#f1fa8c

process.list.normaluserspace=#50fa7b
process.list.lowpriority=#0000FF
process.list.highcpu=#bd93f9
process.list.iobound=#bd93f9
process.list.script=#e3b341
process.list.user.currentnonroot=#f8f8f2
process.list.user.othernonroot=#f1fa8c
process.list.user.system=#ff79c6
process.list.user.root=#50fa7b
process.list.deltahighlight=#ffb86c

heatmap.size.small=#f1fa8c
heatmap.size.mid=#ffb86c
heatmap.size.large=#bd93f9
heatmap.state.scanning=#000000
heatmap.state.completed=#000000
heatmap.state.faulted=#000000

app.error=#db61a2

menubar.foreground=#f1fa8c
menubar.background=#282a36

command.foreground=#bd93f9
command.background=#282a36
