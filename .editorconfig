# EditorConfig for taskmon. See docs/CODING_STYLE.md for the rules a tool can't express.
root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 4
insert_final_newline     = true
# Existing files carry trailing whitespace; trimming on save would add noise to every diff.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.cs]

# Layout
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Braces: new line for types and members, same line for control blocks, lambdas,
# accessors and initializers. else/catch/finally start a new line.
csharp_new_line_before_open_brace = types,methods,properties,indexers,events,local_functions
csharp_new_line_before_else    = true
csharp_new_line_before_catch   = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = false
csharp_preserve_single_line_blocks     = true
csharp_preserve_single_line_statements = false

# Column alignment of declarations is intentional; don't let the formatter collapse it.
csharp_space_around_declaration_statements = ignore

# Explicit types are the convention; var is reserved for long or anonymous types.
csharp_style_var_for_built_in_types    = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere             = false:suggestion

# Language preferences
csharp_preferred_modifier_order = public, private, protected, internal, file, new, static, abstract, virtual, sealed, readonly, override, extern, unsafe, volatile, async, required:suggestion
csharp_style_prefer_utf8_string_literals              = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access        = true:suggestion
dotnet_style_qualification_for_event                  = false:suggestion
dotnet_style_qualification_for_field                  = false:suggestion
dotnet_style_qualification_for_method                 = false:suggestion
dotnet_style_qualification_for_property               = false:suggestion
dotnet_style_require_accessibility_modifiers          = for_non_interface_members:suggestion
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:none
dotnet_style_parentheses_in_other_binary_operators      = always_for_clarity:none
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:none

# Naming
dotnet_naming_style.pascal_case_style.capitalization  = pascal_case
dotnet_naming_style.camel_case_style.capitalization   = camel_case
dotnet_naming_style.interface_style.capitalization    = pascal_case
dotnet_naming_style.interface_style.required_prefix   = I

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_rule.symbols  = interfaces
dotnet_naming_rule.interfaces_rule.style    = interface_style
dotnet_naming_rule.interfaces_rule.severity = warning

# Private constants: PascalCase. Win32 constants may keep their SDK names (e.g. PDH_CSTATUS_NEW_DATA);
# Rider honours the AA_BB allowance below, Roslyn reports them as suggestions only.
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.applicable_kinds           = field
dotnet_naming_symbols.private_constants.required_modifiers         = const
dotnet_naming_symbols.private_constants.resharper_applicable_kinds = constant_field
dotnet_naming_rule.private_constants_rule.symbols         = private_constants
dotnet_naming_rule.private_constants_rule.style           = pascal_case_style
dotnet_naming_rule.private_constants_rule.severity        = suggestion
dotnet_naming_rule.private_constants_rule.resharper_style = AaBb, AA_BB

# Private static readonly fields: PascalCase.
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.applicable_kinds           = field
dotnet_naming_symbols.private_static_readonly.required_modifiers         = static, readonly
dotnet_naming_rule.private_static_readonly_rule.symbols  = private_static_readonly
dotnet_naming_rule.private_static_readonly_rule.style    = pascal_case_style
dotnet_naming_rule.private_static_readonly_rule.severity = warning

# Other private fields (instance and static): camelCase, no underscore prefix.
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.applicable_kinds           = field
dotnet_naming_rule.private_fields_rule.symbols  = private_fields
dotnet_naming_rule.private_fields_rule.style    = camel_case_style
dotnet_naming_rule.private_fields_rule.severity = warning

# Interop code mirrors native SDK names and layouts (e.g. CM_NOTIFY_FILTER.UnionPadding,
# InlineArray _element0), so private field naming isn't enforced there.
[src/Task.Monitor.Interop.*/**.cs]
dotnet_naming_rule.private_fields_rule.severity = none

[*.cs]

# ReSharper / Rider
resharper_csharp_allow_comment_after_lbrace = true
resharper_csharp_empty_block_style          = together_same_line
resharper_formatter_off_tag                 = @formatter:off
resharper_formatter_on_tag                  = @formatter:on
resharper_formatter_tags_enabled            = true
resharper_arrange_redundant_parentheses_highlighting = hint
resharper_arrange_this_qualifier_highlighting        = hint
resharper_arrange_type_member_modifiers_highlighting = hint
resharper_arrange_type_modifiers_highlighting        = hint
resharper_redundant_base_qualifier_highlighting      = warning
